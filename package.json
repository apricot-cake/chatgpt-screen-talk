{
  "name": "chatgpt-screen-talk",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "共有画面を参照しながらChatGPTと音声で会話するローカルアプリ",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "npm run build && node dist/server/server.js",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.launcher.json",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "pretest": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/test/*.test.js test/launcher.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fastify/sse": "0.6.1",
    "@fastify/static": "10.1.7",
    "@fastify/type-provider-typebox": "6.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "eventsource": "^5.1.3",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
